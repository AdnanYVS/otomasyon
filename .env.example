# Yume Creative Lab — environment variables template
# Copy to .env (gitignored) and fill in actual values when integrating real APIs (Faz 4).
# Phase 1 runs in MOCK mode — none of these are required yet.

# === LLM Providers ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Search / Trends (Ajan 1 — Writer) ===
TAVILY_API_KEY=
SERPER_API_KEY=

# === Image Generation (Ajan 3 — Visual) ===
# DALL·E 3 uses OPENAI_API_KEY above
STABILITY_API_KEY=

# === SEO Tools (Ajan 2 — SEO) ===
PAGESPEED_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=

# === Ads (Ajan 4 — Ads Manager, read-only) ===
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
META_GRAPH_ACCESS_TOKEN=

# === Runtime ===
# Set to "mock" (default) or "anthropic" / "openai" once keys are configured
YUME_LLM_MODE=mock
